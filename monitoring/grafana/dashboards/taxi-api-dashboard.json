  "panels": [
    {
      "id": 1,
      "title": "Total Prediction Requests",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{ "expr": "taxi_prediction_requests_total", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Request Rate (requests/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "rate(taxi_prediction_requests_total[1m])", "refId": "A", "legendFormat": "requests/s" }]
    },
    {
      "id": 3,
      "title": "Average Prediction Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{
        "expr": "rate(taxi_prediction_latency_seconds_sum[1m]) / rate(taxi_prediction_latency_seconds_count[1m])",
        "refId": "A", "legendFormat": "avg latency"
      }]
    },
    {
      "id": 4,
      "title": "Average Predicted Trip Duration (min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "m" }, "overrides": [] },
      "targets": [{
        "expr": "rate(taxi_predicted_duration_minutes_sum[1m]) / rate(taxi_predicted_duration_minutes_count[1m])",
        "refId": "A", "legendFormat": "avg predicted duration"
      }]
    }
  ],
